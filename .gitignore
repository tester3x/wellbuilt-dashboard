# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# One-off audit / inspection / recovery scripts created ad-hoc against the
# Firebase Admin SDK. Convention: prefix with `_` to mark as non-deploy
# (Cloud Functions deploy ignores them anyway because they don't `export`
# Cloud Function handlers, but this keeps them out of git history). Delete
# after use or leave on disk — either way, they don't ship.
functions/_*.js
functions/_*.mjs
functions/_*.ts
functions/serviceAccountKey.json
next-env.d.ts

# Firebase functions
functions/node_modules
functions/lib

# Firebase
.firebase/
nul

serviceAccountKey.json
