# vercel
.vercel

# typescript
*.tsbuildinfo

# One-off audit / inspection / recovery scripts created ad-hoc against the
# Firebase Admin SDK. Convention: prefix with `_` to mark as non-deploy
# (Cloud Functions deploy ignores them anyway because they don't `export`
# Cloud Function handlers, but this keeps them out of git history). Delete
# after use or leave on disk — either way, they don't ship.
functions/_*.js
functions/_*.mjs
functions/_*.ts
# vc51.9I-SEC: `functions/_phase1-deployed.json` was a local
# `firebase functions:list --json` dump. It carried the deployed
# environmentVariables verbatim, which meant live provider API keys sat
# untracked-but-committable inside the Functions deployment boundary. The
# `functions/_*` convention already marked these local scratch artifacts,
# but .json was missing from the family — close it, and name the
# deployment-inventory shapes explicitly so a different filename cannot
# reopen the hole.
functions/_*.json
functions/*-deployed.json
functions/*deployment-inventory*.json
functions/functions-list*.json
_phase1-deployed.json
functions/serviceAccountKey.json
next-env.d.ts

# Firebase functions
functions/node_modules
functions/lib

# Firebase
.firebase/
nul

serviceAccountKey.json
security/tests/node_modules/
security/tests/package-lock.json
security/tests/last-predeploy.log
firestore-debug.log
database-debug.log
