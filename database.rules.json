{
  "rules": {
    ".read": true,
    ".write": false,

    "users": {
      "$uid": {
        "email": {
          ".write": "auth != null && auth.uid === $uid && newData.isString() && newData.val().length > 0 && newData.val().length <= 320"
        },
        "displayName": {
          ".write": "auth != null && auth.uid === $uid && newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        }
      }
    },

    "drivers": {
      "profiles": {
        ".write": false,
        "$driverId": {
          ".write": false
        }
      },
      "approved": {
        ".write": false,
        "$hash": {
          ".write": false
        }
      },
      "pending": {
        ".write": false,
        "$id": {
          ".write": false
        }
      },
      "pending_secure": {
        ".write": false,
        "$id": {
          ".write": false
        }
      }
    },

    "wellConfig": {
      ".write": false,
      "$id": {
        ".write": false
      }
    },

    "trusted_staff_authority": {
      ".write": false,
      "$id": {
        ".write": false
      }
    },

    "well_config": {
      "$well": {
        "route": {
          ".write": "auth != null && root.child('well_config').child($well).exists() && (newData.isString() || !newData.exists())"
        },
        "routeRecording": {
          ".write": "auth != null && root.child('well_config').child($well).exists() && (newData.isBoolean() || !newData.exists())"
        },
        "routeGroupWell": {
          ".write": "auth != null && root.child('well_config').child($well).exists() && (newData.isString() || !newData.exists())"
        }
      }
    },

    "packets": {
      "incoming": {
        ".write": false,
        "$id": {
          ".write": false
        }
      },
      "processed": {
        ".indexOn": ["driverId", "driverName", "wellName", "invoiceDocId"]
      }
    }
  }
}
