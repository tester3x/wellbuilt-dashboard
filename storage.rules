rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isDriver() { return signedIn() && request.auth.token.kind == 'driver'; }
    function driverId() { return request.auth.token.driverId; }
    function companyId() { return request.auth.token.companyId; }
    function isPlatformAdmin() {
      return signedIn() && request.auth.token.wellbuiltAdmin == true;
    }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function isPdf() { return request.resource.contentType == 'application/pdf'; }
    function underSize(n) { return request.resource.size < n; }

    // Server-issued shape: photos/{companyId}/{driverId}/{invoiceId}/{file}
    match /photos/{cid}/{did}/{invoiceId}/{fileName} {
      allow read: if isPlatformAdmin() || (isDriver() && companyId() == cid && driverId() == did);
      // Client writes denied. Uploads go through signed URLs from requestStorageUploadPath.
      allow write: if false;
    }

    match /chat_photos/{cid}/{did}/{threadId}/{fileName} {
      allow read: if isPlatformAdmin() || (isDriver() && companyId() == cid && driverId() == did);
      allow write: if false;
    }

    match /jsa/{cid}/{did}/{allPaths=**} {
      allow read: if isPlatformAdmin() || (isDriver() && companyId() == cid && driverId() == did);
      allow write: if false;
    }

    match /ewallet/{driverKey}/{allPaths=**} {
      allow read: if isPlatformAdmin() || (isDriver() && driverId() == driverKey);
      // Client writes denied. Uploads go through one-object signed URLs.
      allow write: if false;
    }

    match /vehicle_documents/{cid}/{allPaths=**} {
      allow read: if isPlatformAdmin() || (isDriver() && companyId() == cid);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
