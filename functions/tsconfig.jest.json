{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // @tester3x/wellbuilt-contracts@0.7.0 is pure ESM. ts-jest compiles its
    // published .js to CommonJS so tests load the real package, not a stub.
    "allowJs": true,
    "noUnusedLocals": false
  },
  "include": ["src", "node_modules/@tester3x/wellbuilt-contracts"],
  "exclude": []
}
