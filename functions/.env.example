# ─────────────────────────────────────────────────────────────────────────────
# Cloud Functions environment template.
# Copy this to functions/.env on the machine you deploy functions from, fill in
# real values, then: cd functions && npm run build && firebase deploy --only functions
# (functions/.env is gitignored — only this .example is tracked.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Photo-compliance AI provider ────────────────────────────────────────────
# Which vision model validatePhotoCompliance + suggestPhotoCriteria use.
#   claude  (default) — uses ANTHROPIC_API_KEY. Working today, no billing blocker.
#   gemini            — uses GEMINI_API_KEY. ~30x cheaper (gemini-2.0-flash), but
#                       only flip this AFTER the Gemini project's billing/credits
#                       are restored AND GEMINI_API_KEY below is a working key.
#                       Switching with no valid key breaks photo validation
#                       (every required photo errors and sits 'pending').
#
# To ENABLE Gemini: set this to gemini, fill GEMINI_API_KEY, redeploy functions.
PHOTO_COMPLIANCE_PROVIDER=claude

# Anthropic (Claude) — required while PHOTO_COMPLIANCE_PROVIDER=claude (and used
# by the other Claude-backed functions regardless).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini — required when PHOTO_COMPLIANCE_PROVIDER=gemini. Get a key from
# Google AI Studio; the key's Google Cloud project must have the Generative
# Language API enabled and active billing/credits.
GEMINI_API_KEY=your-gemini-key-here

# ── Misc ─────────────────────────────────────────────────────────────────────
# Admin email used by the well-catalog refresh job.
WELL_REFRESH_ADMIN_EMAIL=admin@example.com
